# ── Team access (Scult Stage presenter + admin) ─────────────────
# Shared passcode your team types at /login. Use a long, random phrase.
STAGE_PASSCODE=
# 32+ random characters used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# ── Content repo ────────────────────────────────────────────────
# Production: read the private repo through the GitHub API.
CONTENT_REPO=SCULT-INDIA/scult-academy-content
CONTENT_BRANCH=main
# Fine-grained GitHub token with Contents: Read and write on that repo only.
CONTENT_TOKEN=
# Local development: point at a local checkout instead (takes precedence).
# git clone https://github.com/SCULT-INDIA/scult-academy-content.git .content
CONTENT_DIR=

# Public site URL (used in certificate QR codes and links)
NEXT_PUBLIC_SITE_URL=https://academy.scult.in
